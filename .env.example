# Skopiuj do .env (plik .env nie trafia do repozytorium)
# Konto administratora (login: admin). ZMIEŃ przed udostępnieniem strony.
ADMIN_PASSWORD=admin123
# Konta testowe dysponent/administrator/moderator – tylko do testów automatycznych (tak = włączone)
# AED_KONTA_TESTOWE=tak
# Organizacja konta demo dostawcy (pole dysponent_nazwa) – jeden z fikcyjnych dostawców w data/dostawcy
DEMO_DYSPONENT_NAZWA=Urząd Gminy Przykładowo
AED_SECRET=zmien-mnie
# Publiczny adres API – trafia do linków w pliku XML importu i metadanych DCAT
AED_PUBLIC_URL=http://localhost:8000
# Warstwa pomocnicza OSM („Do sprawdzenia”) przy pierwszym starcie: auto | sample | full | none
AED_SEED_OSM=auto
# Wspólna lista przy pierwszym starcie: auto (fikcyjni dostawcy + zbiory oznaczone w dane.gov.pl) | lokalna | none
AED_SEED_LISTA=auto
# brak = agregacja bez sieci (tylko data/dostawcy)
AED_DGP=tak
# Limit anonimowych zgłoszeń i potwierdzeń na minutę z jednego adresu
AED_RATE_PER_MIN=20
# Wyszukiwarka miejsc: gugik = miejscowości, ulice i adresy z usługi geokodowania GUGiK (internet); brak = tylko województwa i gminy z PRG
AED_GEOKODER=gugik
