# Skopiuj do .env (plik .env nie trafia do repozytorium)
DEMO_DYSPONENT_PASSWORD=dysponent-demo
DEMO_MODERATOR_PASSWORD=moderator-demo
AED_SECRET=zmien-mnie
# Publiczny adres API – trafia do linków w pliku XML importu i metadanych DCAT
AED_PUBLIC_URL=http://localhost:8000
# Warstwa OSM przy pierwszym starcie: auto | sample | full | none
AED_SEED_OSM=auto
