# Fuseki portalu (backend/docker/rdfdb/Dockerfile) + certyfikat proxy HTTPS w etapie weryfikacji; ścieżki względem portal/
FROM alpine:3.22.4 AS verify

ENV GNUPGHOME=/tmp/gnupg
# środowisko lokalne (CR-TL-9): sieć tylko przez proxy HTTPS z własnym certyfikatem
ARG https_proxy
ARG HTTPS_PROXY
COPY ./local/proxy-ca.crt /tmp/proxy-ca.crt
RUN cat /tmp/proxy-ca.crt >> /etc/ssl/certs/ca-certificates.crt

RUN set -euxo pipefail \
    && apk add --no-cache gnupg curl \
    && mkdir -p "$GNUPGHOME" \
    && chmod 700 "$GNUPGHOME" \
    && curl -fsSL https://downloads.apache.org/jena/KEYS | gpg --batch --import

WORKDIR /usr/src

COPY ./backend/docker/rdfdb/fuseki/dist/apache-jena-fuseki-6.2.0.tar.gz .
COPY ./backend/docker/rdfdb/fuseki/dist/apache-jena-fuseki-6.2.0.tar.gz.asc .
COPY ./backend/docker/rdfdb/fuseki/dist/apache-jena-fuseki-6.2.0.tar.gz.sha512 .

RUN set -euxo pipefail \
    && sha512sum -c apache-jena-fuseki-6.2.0.tar.gz.sha512 \
    && gpg --verify apache-jena-fuseki-6.2.0.tar.gz.asc apache-jena-fuseki-6.2.0.tar.gz \
    && mkdir -p dist \
    && tar -xzf apache-jena-fuseki-6.2.0.tar.gz -C dist --strip-components=1

FROM eclipse-temurin:21-jre AS runner

ENV FUSEKI_HOME=/opt/fuseki
ENV FUSEKI_BASE=/var/lib/fuseki

RUN useradd -u 10001 -r -s /bin/nologin fuseki

WORKDIR $FUSEKI_HOME

COPY --from=verify /usr/src/dist .

RUN chown -R root:root $FUSEKI_HOME \
    && chmod -R 755 $FUSEKI_HOME

RUN mkdir -p $FUSEKI_BASE/configuration \
    && chown -R fuseki:fuseki $FUSEKI_BASE

COPY ./backend/docker/rdfdb/fuseki/configuration $FUSEKI_BASE/configuration
COPY ./backend/docker/rdfdb/entrypoint.sh /entrypoint.sh

RUN chmod a+x /entrypoint.sh

USER fuseki

ENTRYPOINT ["/entrypoint.sh"]
